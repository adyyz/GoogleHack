# Documentation only: Python currently reads process environment variables.
# Local defaults are safe and require no Google Cloud account.
APP_MODE=local
GOOGLE_CLOUD_PROJECT=demo-aml-insight
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
LIVE_AI_ENABLED=false
CREDITS_VERIFIED=false
GEMINI_MODEL=gemini-3.5-flash
OPERATOR_UIDS=operator-demo
ADMIN_UIDS=operator-demo
# Required timezone-aware expiry before cloud live AI can be enabled.
CREDIT_VERIFIED_UNTIL=
# Exact supported tuple, populated only after cloud model/location verification.
VERIFIED_CLOUD_MODEL_ID=
VERIFIED_CLOUD_LOCATION=
# Optional non-secret per-agent JSON. Blank uses the primary model for every leg.
# config/agent_profiles.json is a preparation example, not verified model coverage.
AGENT_PROFILES_JSON=
# Optional reviewed non-secret JSON rate card; blank means UNKNOWN cost.
# See config/rate-card.example.json. Pinning it never authorizes live requests.
VERIFIED_RATE_CARD_JSON=
# Same verified source SHA256 in publisher, web and worker; pinned in cloud bundles.
DEPLOYED_CODE_FINGERPRINT=
# Public Firebase web-app configuration, restricted to Firebase Authentication.
# Never use GEMINI_API_KEY or a Secret Manager model key here.
FIREBASE_WEB_API_KEY=

# Interim Developer API is a separate opt-in; does not authorize cloud resources.
# The gateway integration is still being prepared. Keep disabled until verified.
LOCAL_GEMINI_ENABLED=false
LOCAL_GEMINI_FREE_VERIFIED=false
LOCAL_GEMINI_VERIFIED_UNTIL=
# GEMINI_API_KEY comes from Secret Manager into process memory, never this file.

# Future cloud target supplied by the user: genesis-aicb (638299117256).
# Credit coverage is UNKNOWN. Do not switch to cloud mode or enable AI yet.

# Private Cloud Tasks delivery: preparation only, disabled until release approval.
CLOUD_TASKS_ENABLED=false
TASK_QUEUE_PATH=
WORKER_AUDIENCE=
TASK_INVOKER_EMAIL=
