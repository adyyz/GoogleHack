        "effective_from": "Timestamp?",
        "source_url": "pricing source URL?",
        "currency": "USD for RATE_CARD",
        "billing_rules": "model/region/tier/cache/thought token applicability for RATE_CARD",
        "content_hash": "canonical SHA-256"
      },
      "links": [
