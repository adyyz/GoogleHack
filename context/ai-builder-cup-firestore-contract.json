      "fields": {
        "kind": "PROMPT|SKILL|CONTEXT|RISK_POLICY|RATE_CARD|BUNDLE",
        "leg_id": "agent ID?",
        "parent_id": "config_versions ID?",
        "origin": "BASELINE|EVOLUTION_CANDIDATE",
        "body": "bounded map: instructions/schema/tool allowlist/context policy/weights/rates",
