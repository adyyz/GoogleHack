      "writer": "model gateway transaction",
      "immutable": false,
      "fields": {
        "day_utc": "string",
        "attempts_reserved": "integer <= 120",
        "limit": "integer = 120",
        "live_enabled": "boolean",
        "credit_verified_until": "Timestamp?",
        "revision": "integer",
        "reserved_attempt_ids": "bounded step_runs IDs"
      },
      "links": [
        "step_runs"
      ]
    }
  ],
  "relational_ddl_equivalent": {
    "primary_keys": "document_id",
    "foreign_keys": "links and named *_id fields, checked by backend",
    "unique_keys": [
      "alerts(dataset_id, trigger_transaction_id, rule_id)",
      "step_runs(run_id, leg_id, attempt_number)",
      "feedback_events(alert_id, revision)"
    ],
    "checks": [
      "scores in [0,1]",
      "risk weights sum to 1",
      "amounts are integer minor units",
      "every run pins an immutable BUNDLE",
      "no activation of recommendations",
      "unknown costs/tokens remain null",
      "HOLDOUT labels excluded from model inputs"
    ]
  },
  "indexes": [
    [
      "transactions",
      [
        "dataset_id:ASCENDING",
        "account_id:ASCENDING",
        "occurred_at:ASCENDING"
      ]
    ],
    [
